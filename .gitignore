# Python
__pycache__/
*.pyc
.venv/

# Tool-owned caches: each tool keeps its own directory
.pytest_cache/
.ruff_cache/
.hypothesis/

# Unified redirect for tool caches
.cache/

# Temporary files
.tmp/
.tmp*/

# Test artifacts: screenshots, reports, failed cases
.artifacts/

# Build outputs
dist/
build/

# Environment
.env
.env.*
!.env.example

# Local working state
.log/
.dagger/sdk/
.unregistered/
/.unregistered/
.agent/
# Local plugin installs and agent state stay untracked; the vendored ADR
# Skill is a repository asset and is tracked.
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/architecture-decision-record-skill/
.test-tools/
.issue-*.md
